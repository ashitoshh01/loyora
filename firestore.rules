rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication & Claim Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isBusinessAdmin(businessId) {
      return isAuthenticated() &&
        request.auth.token.role == 'business_admin' &&
        request.auth.token.businessId == businessId;
    }

    function isCustomer(businessId) {
      return isAuthenticated() &&
        request.auth.token.role == 'customer' &&
        request.auth.token.businessId == businessId;
    }

    // 1. Platform Users Collection (Super Admin Only)
    match /platform_users/{userId} {
      allow read, write: if isSuperAdmin();
    }

    // 2. Membership Plans Collection
    match /membership_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 3. Businesses Tenant Hierarchy
    match /businesses/{businessId} {
      allow read: if isSuperAdmin() || isBusinessAdmin(businessId) || isCustomer(businessId);
      allow write: if isSuperAdmin() || isBusinessAdmin(businessId);

      // Business Admins
      match /business_admins/{adminId} {
        allow read, write: if isSuperAdmin() || isBusinessAdmin(businessId);
      }

      // Customers
      match /customers/{customerId} {
        allow read: if isSuperAdmin() ||
                     isBusinessAdmin(businessId) ||
                     (isCustomer(businessId) && request.auth.uid == customerId);
        allow write: if isSuperAdmin() || isBusinessAdmin(businessId);
      }

      // Memberships
      match /memberships/{membershipId} {
        allow read: if isSuperAdmin() ||
                     isBusinessAdmin(businessId) ||
                     (isCustomer(businessId) && (request.auth.uid == membershipId || resource.data.customerId == request.auth.uid));
        allow write: if isSuperAdmin() || isBusinessAdmin(businessId);
      }

      // NFC Cards
      match /nfc_cards/{cardId} {
        allow read: if isSuperAdmin() ||
                     isBusinessAdmin(businessId) ||
                     (isCustomer(businessId) && resource.data.customerId == request.auth.uid);
        allow write: if isSuperAdmin() || isBusinessAdmin(businessId);
      }

      // Loyalty Programs & Rules
      match /loyalty_programs/{programId} {
        allow read: if isSuperAdmin() || isBusinessAdmin(businessId) || isCustomer(businessId);
        allow write: if isSuperAdmin() || isBusinessAdmin(businessId);

        match /loyalty_rules/{ruleId} {
          allow read: if isSuperAdmin() || isBusinessAdmin(businessId) || isCustomer(businessId);
          allow write: if isSuperAdmin() || isBusinessAdmin(businessId);
        }
      }

      // Visits (Immutable Visit Log)
      match /visits/{visitId} {
        allow read: if isSuperAdmin() ||
                     isBusinessAdmin(businessId) ||
                     (isCustomer(businessId) && resource.data.customerId == request.auth.uid);
        allow write: if isSuperAdmin() || isBusinessAdmin(businessId);
      }

      // Rewards
      match /rewards/{rewardId} {
        allow read: if isSuperAdmin() ||
                     isBusinessAdmin(businessId) ||
                     (isCustomer(businessId) && resource.data.customerId == request.auth.uid);
        allow write: if isSuperAdmin() || isBusinessAdmin(businessId);
      }
    }
  }
}
